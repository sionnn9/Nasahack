      "source": "Demo scenario limits",
      "low": 0,
      "high": 1440
    },
    {
      "id": "motion-plausible",
      "metric": "motion",
      "why": "The motion sensor reports relative g; values above this are treated as artifacts.",
      "source": "Demo scenario limits",
      "low": 0,
      "high": 5
    },
    {
      "id": "self-report-scale",
      "metric": "mood",
      "why": "Self-reported answers use a five point scale.",
      "source": "Demo scenario limits",
      "low": 1,
      "high": 5
    }
  ]
