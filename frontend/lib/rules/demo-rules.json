{
  "notice": "DEMO RULE — not clinically reviewed",
  "rules": [
    {
      "id": "heart_rate-plausible",
      "metric": "heart_rate",
      "why": "Sensor sanity only: numbers outside this range usually mean bad contact or a dropped sample.",
      "source": "Demo scenario limits",
      "low": 30,
      "high": 220
    },
    {
      "id": "skin_temp-plausible",
      "metric": "skin_temp",
      "why": "A skin sensor that reports far outside body range is treated as a bad sample.",
      "source": "Demo scenario limits",
      "low": 28,
      "high": 42
    },
    {
      "id": "bp_systolic-plausible",
      "metric": "bp_systolic",
      "why": "Cuff errors and motion often produce implausible systolic values.",
      "source": "Demo scenario limits",
      "low": 60,
      "high": 250
    },
    {
      "id": "bp_diastolic-plausible",
      "metric": "bp_diastolic",
      "why": "Cuff errors and motion often produce implausible diastolic values.",
      "source": "Demo scenario limits",
      "low": 30,
      "high": 150
    },
    {
      "id": "glucose-plausible",
      "metric": "glucose",
      "why": "A glucose value outside this range is treated as a meter error until repeated.",
      "source": "Demo scenario limits",
      "low": 1,
      "high": 35
    },
    {
      "id": "sleep_minutes-plausible",
      "metric": "sleep_minutes",
