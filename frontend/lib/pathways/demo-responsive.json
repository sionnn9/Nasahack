{
  "id": "demo-responsive",
  "label": "ILLUSTRATIVE — NOT CLINICALLY REVIEWED",
  "title": "Crewmate is responding",
  "category": "emergency",
  "triggers": ["emergency:responding"],
  "steps": [
    {
      "id": "r1",
      "type": "question",
      "text": "Can they speak or answer a simple question?",
      "options": ["Yes", "No", "Unsure"],
      "next": { "Yes": "r2", "No": "demo-unresponsive", "Unsure": "demo-unsure" }
    },
    {
      "id": "r2",
      "type": "urgent_check",
      "text": "Are they having chest discomfort, trouble breathing, or a sudden vision change?",
      "options": ["Yes", "No", "Unsure"],
      "next": { "Yes": "r3", "No": "r4", "Unsure": "r4" }
    },
    {
      "id": "r3",
      "type": "action",
      "text": "Call the crew medical officer now. Keep them still and stay with them.",
      "timer_minutes": 5,
      "next": { "default": "r5" }
    },
    {
      "id": "r4",
      "type": "action",
      "text": "Sit them down, keep them company, and start a timer.",
      "timer_minutes": 10,
      "next": { "default": "r5" }
    },
    {
      "id": "r5",
      "type": "measure",
      "metric": "heart_rate",
      "needs": null,
      "text": "Record their heart rate if a sensor is available.",
      "next": { "default": "r6" }
    },
    {
      "id": "r6",
      "type": "note",
      "text": "Write down what you saw and when it started. Generate a handoff when ready.",
      "next": { "default": "DONE" }
    }
  ],
  "reassess": {
    "after_minutes": 10,
    "question": "How are they now?",
    "options": ["Better", "Same", "Worse", "Unsure"],
    "next": { "Better": "close", "Same": "handoff", "Worse": "EMERGENCY", "Unsure": "handoff" }
  }
}
