{
  "id": "lightheaded-v1",
  "label": "ILLUSTRATIVE — NOT CLINICALLY REVIEWED",
  "title": "Feeling light-headed or weak",
  "category": "assessment",
  "triggers": ["symptom:Dizziness", "concern:any", "symptom:Tired"],
  "steps": [
    {
      "id": "s1",
      "type": "question",
      "text": "Did this start after exercise, a position change, or a meal?",
      "options": ["Exercise", "Position change", "Meal", "None of these", "Unsure"],
      "next": { "default": "s2" }
    },
    {
      "id": "s2",
      "type": "urgent_check",
      "text": "Are you having chest discomfort, fainting, or trouble breathing?",
      "options": ["Yes", "No", "Unsure"],
      "next": { "Yes": "EMERGENCY", "No": "s3", "Unsure": "EMERGENCY" }
    },
    {
      "id": "s3",
      "type": "measure",
      "metric": "bp_systolic",
      "needs": "bp_cuff",
      "alt": "s3b",
      "text": "Take a blood pressure reading while seated.",
      "next": { "default": "s4" }
    },
    {
      "id": "s3b",
      "type": "note",
      "text": "Cuff unavailable. Assessment is incomplete.",
      "next": { "default": "s4" }
    },
    {
      "id": "s4",
      "type": "measure",
      "metric": "heart_rate",
      "needs": null,
      "text": "Record your heart rate at rest.",
      "next": { "default": "s5" }
    },
    {
      "id": "s5",
      "type": "action",
      "text": "Sit or lie down and rest. Tell the crew.",
      "timer_minutes": 15,
      "next": { "default": "reassess" }
    }
  ],
  "reassess": {
    "after_minutes": 15,
    "question": "How do you feel now?",
    "options": ["Better", "Same", "Worse", "Unsure"],
    "next": { "Better": "close", "Same": "handoff", "Worse": "EMERGENCY", "Unsure": "handoff" }
  }
}
